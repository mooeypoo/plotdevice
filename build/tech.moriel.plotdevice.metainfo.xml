<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>tech.moriel.plotdevice</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Plot Device</name>
  <summary>Write a novel in plain Markdown files</summary>
  <developer id="tech.moriel">
    <name>Moriel Schottlender</name>
  </developer>
  <description>
    <p>Plot Device is a local writing and story-planning app for novelists.
    Your project stays a folder of ordinary Markdown files, usable in other
    editors without an account or manuscript upload.</p>
    <p>Organize chapters and parts, keep characters and notes beside your prose,
    and explore outlines, story timelines, and character interactions.
    Write in English, Hebrew, or mixed-direction prose.</p>
  </description>
  <launchable type="desktop-id">plotdevice.desktop</launchable>
  <provides>
    <binary>plotdevice</binary>
  </provides>
  <url type="homepage">https://mooeypoo.github.io/plotdevice/</url>
  <url type="help">https://mooeypoo.github.io/plotdevice/guide/start.html</url>
  <url type="bugtracker">https://github.com/mooeypoo/plotdevice/issues</url>
  <url type="vcs-browser">https://github.com/mooeypoo/plotdevice</url>
  <url type="contact">https://moriel.tech</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>novel</keyword>
    <keyword>writing</keyword>
    <keyword>Markdown</keyword>
    <keyword>outline</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Chapter editor with manuscript binder and story properties</caption>
      <image type="source" width="1200" height="771">https://raw.githubusercontent.com/mooeypoo/plotdevice/main/docs/images/editor.png</image>
    </screenshot>
  </screenshots>
  <releases/>
</component>
