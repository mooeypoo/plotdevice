---
// The footer of the site's own pages: every page of the site, the same page in the other languages, and
// who made it. On a phone, Starlight's header hides its links, so this is how a reader gets around.
import { GUIDE, LANGUAGES, MAKER, path, words, type Lang } from '../site'

const { lang, page = '' } = Astro.props as { lang: Lang; page?: string }
const links = [
  { href: path(lang), text: words(lang, 'nav-why') },
  { href: path(lang, GUIDE), text: words(lang, 'nav-guide') },
  { href: path(lang, 'support/'), text: words(lang, 'nav-support') },
  { href: path(lang, 'languages/'), text: words(lang, 'nav-languages') },
  { href: path(lang, 'compare/'), text: words(lang, 'nav-compare') },
  { href: path(lang, 'docs/about/credits/'), text: words(lang, 'footer-credits') },
  { href: path(lang, 'docs/about/problems/'), text: words(lang, 'footer-problem') },
  { href: path(lang, 'docs/technical/files/folder/'), text: words(lang, 'footer-technical') },
]
const maker = `<a href="${MAKER.href}">${MAKER.name}</a>`
---

<footer class="site-footer">
  <nav aria-label={words(lang, 'nav-label')}>
    <ul>{links.map(({ href, text }) => <li><a {href}>{text}</a></li>)}</ul>
  </nav>
  <p class="languages">
    {words(lang, 'footer-language')}:{' '}
    {
      LANGUAGES.filter((other) => other.lang !== lang).map((other) => (
        <a href={path(other.lang, page)} hreflang={other.lang} lang={other.lang} dir={other.dir}>
          {other.name}
        </a>
      ))
    }
  </p>
  <p class="made-by" set:html={words(lang, 'footer-made-by', maker)} />
</footer>
