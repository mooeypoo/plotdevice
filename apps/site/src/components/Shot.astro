---
// A screenshot of the real app (made by `pnpm site:screenshots`), in this page's language, in the
// light and dark themes; the site's theme shows one. A language without its own screenshots falls
// back to English ones.
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

const { name, alt, eager = false } = Astro.props as { name: string; alt: string; eager?: boolean }
const lang = Astro.locals.starlightRoute.lang
const screens = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*/*.png', { eager: true })
function screen(theme: 'light' | 'dark'): ImageMetadata {
  const found = screens[`../assets/screens/${lang}/${name}-${theme}.png`] ?? screens[`../assets/screens/en/${name}-${theme}.png`]
  if (!found) throw new Error(`No screenshot "${name}-${theme}". Run \`pnpm site:screenshots\` first.`)
  return found.default
}
const sizes = '(min-width: 72rem) 72rem, 100vw'
const widths = [720, 1200, 1800, 2400]
---

<figure class="shot">
  <Image class="only-light" src={screen('light')} {alt} {sizes} {widths} loading={eager ? 'eager' : 'lazy'} />
  <Image class="only-dark" src={screen('dark')} {alt} {sizes} {widths} loading={eager ? 'eager' : 'lazy'} />
</figure>
