{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/contract/**/*",
    "src/preload/*.d.ts"
    ,
    "docs/.vitepress/theme/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "preserve",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    }
  }
}
