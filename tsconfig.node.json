{
  "extends": "./tsconfig.base.json",
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/contract/**/*",
    "tools/**/*",
    "fixtures/*.test.ts"
  ],
  "exclude": ["tools/dependency-rules/fixture/**"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"]
  }
}
