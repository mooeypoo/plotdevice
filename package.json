{
  "name": "plotdevice",
  "private": true,
  "description": "Plot Device: a writing studio for fiction authors, backed by plain Markdown.",
  "license": "GPL-3.0-or-later",
  "author": "Moriel Schottlender <mooeypoo@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @plotdevice/desktop dev",
    "dev:no-sandbox": "pnpm --filter @plotdevice/desktop dev:no-sandbox",
    "build": "pnpm --filter @plotdevice/desktop build",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc --noEmit -p packages/storage/test && pnpm --filter @plotdevice/ui-vue --filter @plotdevice/desktop typecheck",
    "test": "vitest run",
    "arch": "vitest run --config tooling/vitest.arch.config.ts",
    "perf": "vitest run --config vitest.perf.config.ts",
    "e2e": "pnpm build && playwright test",
    "e2e:packaged": "playwright test --config playwright.packaged.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm arch && pnpm perf && pnpm build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
